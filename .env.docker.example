APP_NAME=Webconsig API
APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/webconsig
REDIS_URL=redis://redis:6379/0
SQL_ECHO=false
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

USE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=webconsig.events

LOG_LEVEL=INFO
REQUEST_LOG_BODY_LIMIT=1000
ENABLE_REQUEST_AUDIT=true
REQUEST_AUDIT_EXCLUDE_PATHS=/api/v1/health
CORS_ORIGINS=https://localhost:15443

API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=2

AUTH_ENABLED=true
AUTH_ALLOW_DEV_HEADER_FALLBACK=true
AUTHZ_ENABLED=true
KEYCLOAK_BASE_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=webconsig
KEYCLOAK_CLIENT_ID=webconsig-frontend
KEYCLOAK_VERIFY_TLS=false
KEYCLOAK_JWKS_CACHE_SECONDS=300

VITE_API_URL=/api/v1
VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=https://localhost:15443/auth
VITE_KEYCLOAK_REALM=webconsig
VITE_KEYCLOAK_CLIENT_ID=webconsig-frontend

HTTPS_DOMAIN=localhost
HTTPS_PORT=15443
HTTPS_ADMIN_USER=admin
HTTPS_ADMIN_PASSWORD=trocar-esta-senha

POSTGRES_PORT=15432
REDIS_PORT=16379
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Admin@123!ChangeMe
