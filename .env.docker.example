APP_NAME=Webconsig API
APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/webconsig
REDIS_URL=redis://redis:6379/0
SQL_ECHO=false
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

USE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=webconsig.events

LOG_LEVEL=INFO
REQUEST_LOG_BODY_LIMIT=1000
ENABLE_REQUEST_AUDIT=true
REQUEST_AUDIT_EXCLUDE_PATHS=/api/v1/health
CORS_ORIGINS=https://localhost:15443

API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=2

VITE_API_URL=/api/v1

HTTPS_DOMAIN=localhost
HTTPS_PORT=15443
HTTPS_ADMIN_USER=admin
HTTPS_ADMIN_PASSWORD=trocar-esta-senha

POSTGRES_PORT=15432
REDIS_PORT=16379
