# ===========================================
# Configurações do Sistema
# ===========================================
# Copie este arquivo para .env e ajuste os valores

# Ambiente: Debug ou Production
DEBUG=True
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# ===========================================
# Banco de Dados
# ===========================================
# Opções de DB_ENGINE:
#   - sqlite (padrão, desenvolvimento)
#   - mssql+pyodbc (SQL Server com pyodbc)
#   - postgresql (PostgreSQL)
#   - mysql+pymysql (MySQL/MariaDB)

DB_ENGINE=mssql+pyodbc
DB_HOST=localhost
DB_PORT=1433
DB_NAME=webconsig
DB_USERNAME=sa
DB_PASS=sua_senha_aqui

# Driver ODBC para SQL Server (apenas para mssql+pyodbc)
# Opções comuns:
#   - ODBC Driver 18 for SQL Server
#   - ODBC Driver 17 for SQL Server
#   - SQL Server Native Client 11.0
DB_DRIVER=ODBC Driver 17 for SQL Server

# Opções adicionais SQL Server
DB_TRUST_CERTIFICATE=yes
DB_ENCRYPT=no

# ===========================================
# OAuth (Opcional)
# ===========================================
# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# ===========================================
# Celery - Tarefas Assíncronas (Opcional)
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# ===========================================
# CDN (Opcional)
# ===========================================
CDN_DOMAIN=
CDN_HTTPS=True

# ===========================================
# Assets (Opcional)
# ===========================================
ASSETS_ROOT=/static/assets
